{
  "name": "ai-usage-panel",
  "displayName": "Quota Deck — Claude Code, Codex & Antigravity Usage",
  "description": "%extension.description%",
  "version": "0.1.5",
  "publisher": "richard-jheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ITE-Richard/quota-deck.git"
  },
  "bugs": {
    "url": "https://github.com/ITE-Richard/quota-deck/issues"
  },
  "homepage": "https://github.com/ITE-Richard/quota-deck#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "antigravity",
    "usage",
    "quota"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quotaDeckActivityBar",
          "title": "Quota Deck",
          "icon": "$(graph)"
        }
      ],
      "panel": [
        {
          "id": "quotaDeckPanelContainer",
          "title": "Quota Deck",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "quotaDeckActivityBar": [
        {
          "id": "quotaDeck.viewSidebar",
          "name": "%view.name%",
          "type": "webview"
        }
      ],
      "quotaDeckPanelContainer": [
        {
          "id": "quotaDeck.viewPanel",
          "name": "%view.name%",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "quotaDeck.refreshAll",
        "title": "%command.refreshAll%",
        "icon": "$(refresh)"
      },
      {
        "command": "quotaDeck.refreshClaude",
        "title": "%command.refreshClaude%"
      },
      {
        "command": "quotaDeck.refreshCodex",
        "title": "%command.refreshCodex%"
      },
      {
        "command": "quotaDeck.refreshAntigravity",
        "title": "%command.refreshAntigravity%"
      },
      {
        "command": "quotaDeck.openInEditor",
        "title": "%command.openInEditor%"
      },
      {
        "command": "quotaDeck.claudeUsage",
        "title": "%command.claudeUsage%"
      },
      {
        "command": "quotaDeck.showLogs",
        "title": "%command.showLogs%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quotaDeck.refreshAll",
          "when": "view == quotaDeck.viewSidebar",
          "group": "navigation@1"
        },
        {
          "command": "quotaDeck.refreshAll",
          "when": "view == quotaDeck.viewPanel",
          "group": "navigation@1"
        },
        {
          "command": "quotaDeck.openInEditor",
          "when": "view == quotaDeck.viewSidebar",
          "group": "1_open@1"
        },
        {
          "command": "quotaDeck.openInEditor",
          "when": "view == quotaDeck.viewPanel",
          "group": "1_open@1"
        }
      ]
    },
    "configuration": {
      "title": "Quota Deck",
      "properties": {
        "quotaDeck.providers.claude.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.providers.claude.enabled%"
        },
        "quotaDeck.providers.codex.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.providers.codex.enabled%"
        },
        "quotaDeck.providers.antigravity.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.providers.antigravity.enabled%"
        },
        "quotaDeck.claude.cliPath": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "%config.claude.cliPath%"
        },
        "quotaDeck.claude.autoProbeOnStale": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.claude.autoProbeOnStale%"
        },
        "quotaDeck.codex.cliPath": {
          "type": "string",
          "default": "codex",
          "markdownDescription": "%config.codex.cliPath%"
        },
        "quotaDeck.codex.allowDirectApi": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.codex.allowDirectApi%"
        },
        "quotaDeck.commandTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 120000,
          "markdownDescription": "%config.commandTimeoutMs%"
        },
        "quotaDeck.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.showStatusBarItem%"
        },
        "quotaDeck.statusBar.provider": {
          "type": "string",
          "enum": [
            "lowest",
            "claude",
            "codex",
            "antigravity"
          ],
          "enumDescriptions": [
            "%config.statusBar.provider.lowest%",
            "%config.statusBar.provider.claude%",
            "%config.statusBar.provider.codex%",
            "%config.statusBar.provider.antigravity%"
          ],
          "default": "lowest",
          "markdownDescription": "%config.statusBar.provider%"
        },
        "quotaDeck.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.debug%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "test": "node esbuild.js --test && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
