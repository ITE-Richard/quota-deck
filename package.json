{
  "name": "quota-deck",
  "displayName": "Quota Deck — Claude Code, Codex & Antigravity Usage",
  "description": "在單一面板中檢視 Claude Code、OpenAI Codex 與 Google Antigravity 的用量與配額。純手動更新，資料僅在本機讀取。",
  "version": "0.1.0",
  "publisher": "richard-jheng",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "codex",
    "antigravity",
    "usage",
    "quota"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quotaDeckActivityBar",
          "title": "Quota Deck",
          "icon": "$(graph)"
        }
      ],
      "panel": [
        {
          "id": "quotaDeckPanelContainer",
          "title": "Quota Deck",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "quotaDeckActivityBar": [
        {
          "id": "quotaDeck.viewSidebar",
          "name": "用量",
          "type": "webview"
        }
      ],
      "quotaDeckPanelContainer": [
        {
          "id": "quotaDeck.viewPanel",
          "name": "用量",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "quotaDeck.refreshAll",
        "title": "Quota Deck: Refresh All",
        "icon": "$(refresh)"
      },
      {
        "command": "quotaDeck.refreshClaude",
        "title": "Quota Deck: Refresh Claude"
      },
      {
        "command": "quotaDeck.refreshCodex",
        "title": "Quota Deck: Refresh Codex"
      },
      {
        "command": "quotaDeck.refreshAntigravity",
        "title": "Quota Deck: Refresh Antigravity"
      },
      {
        "command": "quotaDeck.openInEditor",
        "title": "Quota Deck: Open in Editor"
      },
      {
        "command": "quotaDeck.claudeUsage",
        "title": "Quota Deck: Refresh Claude Usage via /usage"
      },
      {
        "command": "quotaDeck.showLogs",
        "title": "Quota Deck: Show Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quotaDeck.refreshAll",
          "when": "view == quotaDeck.viewSidebar",
          "group": "navigation@1"
        },
        {
          "command": "quotaDeck.refreshAll",
          "when": "view == quotaDeck.viewPanel",
          "group": "navigation@1"
        },
        {
          "command": "quotaDeck.openInEditor",
          "when": "view == quotaDeck.viewSidebar",
          "group": "1_open@1"
        },
        {
          "command": "quotaDeck.openInEditor",
          "when": "view == quotaDeck.viewPanel",
          "group": "1_open@1"
        }
      ]
    },
    "configuration": {
      "title": "Quota Deck",
      "properties": {
        "quotaDeck.providers.claude.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否顯示 **Claude Code** 卡片。"
        },
        "quotaDeck.providers.codex.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否顯示 **OpenAI Codex** 卡片。"
        },
        "quotaDeck.providers.antigravity.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否顯示 **Google Antigravity** 卡片。"
        },
        "quotaDeck.claude.cliPath": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Claude CLI 的路徑。留預設值 `claude` 時會先在 `PATH` 中尋找，找不到會自動探測 VSCode 擴充套件內附的 binary。"
        },
        "quotaDeck.codex.cliPath": {
          "type": "string",
          "default": "codex",
          "markdownDescription": "Codex CLI 的路徑。留預設值 `codex` 時會先在 `PATH` 中尋找，找不到會自動探測 VSCode 擴充套件內附的 binary。"
        },
        "quotaDeck.codex.allowDirectApi": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "允許讀取 `auth.json` 並直接查詢 rate limit。**這條路徑會讀取本機認證檔並發出網路請求**，預設關閉；正常情況下不需要開啟，因為 Codex 已把官方配額數字寫在本機工作階段紀錄中。"
        },
        "quotaDeck.commandTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "maximum": 120000,
          "markdownDescription": "每一次 CLI 執行與本機網路請求的 timeout（毫秒）。"
        },
        "quotaDeck.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "是否在狀態列顯示用量摘要。"
        },
        "quotaDeck.statusBar.provider": {
          "type": "string",
          "enum": [
            "lowest",
            "claude",
            "codex",
            "antigravity"
          ],
          "enumDescriptions": [
            "顯示剩餘額度最少的那一家",
            "永遠顯示 Claude",
            "永遠顯示 Codex",
            "永遠顯示 Antigravity"
          ],
          "default": "lowest",
          "markdownDescription": "狀態列要顯示哪一家的用量。"
        },
        "quotaDeck.debug": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "輸出詳細 log 到 `Quota Deck` Output channel。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
